# App
PORT=3000
NODE_ENV=development
IS_LOCAL_ENV=true

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=competitor_pulse

# Tracking
LISTING_SOURCE_URL=http://listing-source:4002
POLL_INTERVAL_MS=900000
POLL_TIMEOUT_MS=10000
POLL_CONCURRENCY=8

# AI summaries use the bundled mock by default. Set AI_API_KEY alone for DeepSeek.
# For another Chat Completions provider, use its base URL, model and optional key.
# AI_API_KEY=
# AI_BASE_URL=https://provider.example/v1
# AI_MODEL=your-provider-model
